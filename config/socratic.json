{
  "enabled": true,
  "max_followups": 3,
  "max_internal_candidates": 10,
  "min_answerability_score": 0.62,
  "min_topic_relevance": 0.5,
  "avoid_same_relation": true,
  "allow_bm25_probe": true,
  "probe_top_k": 5,
  "max_bm25_probes": 3,
  "max_context_passages": 12,
